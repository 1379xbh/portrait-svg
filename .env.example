# Shared provider settings. Use your provider's actual model identifiers.
OPENAI_API_KEY=
OPENAI_BASE_URL='https://maas.qianwenaiapi.com/compatible-mode/v1'
# Image service overrides; blank means use shared settings.
IMAGE_API_KEY=
IMAGE_BASE_URL=''
IMAGE_MODEL='qwen-image-3.0-pro'
IMAGE_QUALITY=medium
# Legacy language model settings; not used by current web routes.
LANGUAGE_API_KEY=
LANGUAGE_BASE_URL=''
LANGUAGE_MODEL='Qwen/Qwen3-VL-32B-Instruct'
# Optional local API Bearer token. Default server binds only 127.0.0.1.
SERVICE_API_KEY=
MODEL_TIMEOUT_SECONDS=600
# Optional offline CPU interpreter. Blank uses local_pipeline/.venv (Windows/Linux).
LOCAL_PYTHON=
LOCAL_TIMEOUT_SECONDS=180
IMAGE_PROVIDER='qianwen'
LANGUAGE_PROVIDER='siliconflow'
